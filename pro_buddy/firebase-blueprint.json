{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "bio": { "type": "string", "maxLength": 160 },
        "college": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "email", "name", "createdAt", "updatedAt"]
    },
    "Evaluation": {
      "title": "Evaluation",
      "description": "Saved project evaluation",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "domain": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 2000 },
        "overallScore": { "type": "number" },
        "verdict": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "title", "overallScore", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles"
    },
    "evaluations/{evaluationId}": {
      "schema": { "$ref": "#/entities/Evaluation" },
      "description": "Stores project evaluations"
    }
  }
}
